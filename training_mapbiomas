// functions
var bmi = function(weight, height){
  var bmi = weight / (height * height)
  return bmi
};

print(bmi(61, 1.69));

// foor loop
var weights = [65, 68, 67, 57, 69]
var heights = [1.77, 1.65, 1.60, 2.00, 1.87]

for (var index = 0; index < weights.length; index = index + 1){
  var weight = weights[index]
  var height = heights[index]
  print(bmi(weight, height))
}

// client-side vs. server-side (in general, any "ee" is server-side)
var clientString = 'Client string';
print(typeof clientString);

var serverString = ee.String('Server string');
print(typeof serverString);

// earth engine objects
// strings
// list
// object = dictionary
// numbers
// images = raster
// image collection = stack of images
// geometry = vector
// geometries = points, polygons
// feature = geometry and a dictionary
// feature collection = a set of features

// practicing featuring
var geometry = ee.Geometry.Point([-30, 32.89]);
var dictionary = ee.Dictionary({name:'point'});
var feature = ee.Feature(geometry, dictionary);

// filtering = restrict collections
// practicing filtering 1
var feature = ee.FeatureCollection('USDOS/LSIB_SIMPLE/2017');
Map.addLayer(feature);
print(feature);
var point = ee.Geometry.Point([-30, 32.89]);
var filter = feature.filterBounds(point);
print(filter);

// practicing filtering 2
var image = ee.ImageCollection("LANDSAT/LC08/C02/T1_TOA");
print(image);
var filter = image.filterDate('2023-12-30', '2023-12-31');
print(filter);

// reducing = transform an image collection into a single image
var max = image.max();
print(max);

// selecting bands
var band = ee.Image('LANDSAT/LC08/C02/T1_TOA/LC08_229057_20241108').select(['B1']);
