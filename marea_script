// ETAPA: PRE-PROCESSAMENTO (reaproveitado do script de manguezal)
// ==================================================

var d1cloudProb = ee.ImageCollection('COPERNICUS/S2_CLOUD_PROBABILITY')
  .filterBounds(babiDegr1)
  .filterDate('2015-01-01', '2026-12-31');

var d1Comb = ee.ImageCollection(ee.Join.saveFirst('s2cloudProb').apply({
  primary: d1,
  secondary: d1cloudProb,
  condition: ee.Filter.equals({leftField: 'system:index', rightField: 'system:index'})
}));

function maskNuvens(img) {
  var nuvemProb = ee.Image(img.get('s2cloudProb')).select('probability');
  var temNuvem = nuvemProb.gt(50);
  var bandas = ['B1','B2','B3','B4','B5','B6','B7','B8','B8A','B9','B11','B12'];

  return img.select(bandas)
    .updateMask(temNuvem.not())
    .divide(10000)
    .copyProperties(img, img.propertyNames());
}

var d1Mask = d1Comb.map(maskNuvens);

// Adicionar a coluna 'estacao' (mesma logica ja definida)
var d1MaskEstacao = d1Mask.map(definirEstacao);

// Ordenar cronologicamente - fundamental para a deteccao de blocos
var d1Ordenado = d1MaskEstacao.sort('system:time_start');

// ==================================================
// ETAPA: DETECTAR BLOCOS DE ESTACAO CONSECUTIVOS
// A deteccao de sequencias (runs) e mais simples client-side, entao
// trazemos apenas indice/data/estacao para o cliente (getInfo),
// processamos os blocos em JS, e devolvemos ao servidor apenas
// os ids das imagens de cada bloco para filtrar a colecao original.
// ==================================================

var d1ListaInfo = d1Ordenado.map(function(img) {
  return ee.Feature(null, {
    'indice': img.get('system:index'),
    'time_start': img.get('system:time_start'),
    'estacao': img.get('estacao')
  });
}).getInfo().features;

// Construir os blocos comparando a estacao de cada imagem com a anterior
var blocos = [];
var blocoAtual = null;

d1ListaInfo.forEach(function(f) {
  var props = f.properties;
  if (blocoAtual === null || blocoAtual.estacao !== props.estacao) {
    blocoAtual = {
      estacao: props.estacao,
      indices: [],
      dataInicio: null,
      dataFim: null
    };
    blocos.push(blocoAtual);
  }
  blocoAtual.indices.push(props.indice);
  var dataImg = ee.Date(props.time_start).format('YYYY-MM-dd').getInfo();
  if (blocoAtual.dataInicio === null) blocoAtual.dataInicio = dataImg;
  blocoAtual.dataFim = dataImg;
});

print('Babi Degradada 1 - Blocos detectados:', blocos);

// ==================================================
// ETAPA: COMPOR/EXPORTAR CADA BLOCO
// Bloco com 1 imagem -> exporta a imagem bruta (ja pre-processada)
// Bloco com 2+ imagens -> composita por mediana antes de exportar
// ==================================================

blocos.forEach(function(bloco, i) {
  var numImg = bloco.indices.length;

  var subColecao = d1Ordenado.filter(ee.Filter.inList('system:index', bloco.indices));

  var imagemFinal = (numImg === 1)
    ? subColecao.first()
    : subColecao.median();

  imagemFinal = imagemFinal.clip(babiDegr1);

  var nomeBloco = 'babiDegr1_bloco' + (i + 1) + '_' + bloco.estacao
    + '_' + bloco.dataInicio + '_a_' + bloco.dataFim;

  print(nomeBloco + ' - n imagens: ' + numImg);

  Export.image.toDrive({
    image: imagemFinal,
    description: nomeBloco,
    folder: 'GEE_Exports',
    fileNamePrefix: nomeBloco,
    region: babiDegr1,
    scale: 10,
    maxPixels: 1e13
  });
});

