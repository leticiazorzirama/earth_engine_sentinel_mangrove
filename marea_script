  'babiDegr1': babiDegr1,
  'babiDegr2': babiDegr2,
  'babiPres1': babiPres1,
  'babiPres2': babiPres2,
  'babiPres3': babiPres3,
  'babiPres4': babiPres4,
  'babiPres5': babiPres5,
  'babiPres6': babiPres6
};

// ======================================================================
// VARIAVEL DE CONTROLE - alterar manualmente a cada execucao
// Valores possiveis: 'babiDegr1', 'babiDegr2', 'babiPres1', 'babiPres2',
// 'babiPres3', 'babiPres4', 'babiPres5', 'babiPres6'
// ======================================================================
var AREA_ATUAL = 'babiPres6';

// ---- PRE-PROCESSAMENTO ----
var colecao = areas[AREA_ATUAL];
var poligono = poligonos[AREA_ATUAL];

var cloudProb = ee.ImageCollection('COPERNICUS/S2_CLOUD_PROBABILITY')
  .filterBounds(poligono)
  .filterDate('2015-01-01', '2026-12-31');

var comb = ee.ImageCollection(ee.Join.saveFirst('s2cloudProb').apply({
  primary: colecao,
  secondary: cloudProb,
  condition: ee.Filter.equals({leftField: 'system:index', rightField: 'system:index'})
}));

function maskNuvens(img) {
  var nuvemProb = ee.Image(img.get('s2cloudProb')).select('probability');
  var temNuvem = nuvemProb.gt(50);
  var bandas = ['B1','B2','B3','B4','B5','B6','B7','B8','B8A','B9','B11','B12'];
  return img.select(bandas)
    .updateMask(temNuvem.not())
    .divide(10000)
    .copyProperties(img, img.propertyNames());
}

var mask = comb.map(maskNuvens);
var maskEstacao = mask.map(definirEstacao);
var ordenado = maskEstacao.sort('system:time_start');

// ---- DETECTAR BLOCOS DE ESTACAO CONSECUTIVOS ----
var listaInfo = ordenado.map(function(img) {
  return ee.Feature(null, {
    'indice': img.get('system:index'),
    'time_start': img.get('system:time_start'),
    'estacao': img.get('estacao')
  });
}).getInfo().features;

var blocos = [];
var blocoAtual = null;

listaInfo.forEach(function(f) {
  var props = f.properties;
  if (blocoAtual === null || blocoAtual.estacao !== props.estacao) {
    blocoAtual = {
      estacao: props.estacao,
      indices: [],
      dataInicio: null,
      dataFim: null
    };
    blocos.push(blocoAtual);
  }
  blocoAtual.indices.push(props.indice);
  var dataImg = ee.Date(props.time_start).format('YYYY-MM-dd').getInfo();
  if (blocoAtual.dataInicio === null) blocoAtual.dataInicio = dataImg;
  blocoAtual.dataFim = dataImg;
});

print(AREA_ATUAL + ' - Blocos detectados:', blocos);

// ---- COMPOR/EXPORTAR CADA BLOCO ----
blocos.forEach(function(bloco, i) {
  var numImg = bloco.indices.length;
  var subColecao = ordenado.filter(ee.Filter.inList('system:index', bloco.indices));

  var imagemFinal = (numImg === 1)
    ? subColecao.first()
    : subColecao.median();

  imagemFinal = imagemFinal.clip(poligono);

  var nomeBloco = AREA_ATUAL + '_bloco' + (i + 1) + '_' + bloco.estacao
    + '_' + bloco.dataInicio + '_a_' + bloco.dataFim;

  print(nomeBloco + ' - n imagens: ' + numImg);

  Export.image.toDrive({
    image: imagemFinal,
    description: nomeBloco,
    folder: 'GEE_Exports',
    fileNamePrefix: nomeBloco,
    region: poligono,
    scale: 10,
    maxPixels: 1e13
  });
});
