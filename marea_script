// Áreas degradadas 
//1
var d1 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED') 
  .filterMetadata('CLOUD_COVERAGE_ASSESSMENT', 'less_than', 5) 
  .filterBounds(babiDegr1);

// Verificar colecao de imagens existentes para a area de interesse
// Conferir os anos das imagens mais antigas e mais recentes
var d1MinData = d1.aggregate_min('system:time_start');
var d1MaxData = d1.aggregate_max('system:time_start');
print('Babi Degradada 1 - MSI L2A - Data mais antiga:', ee.Date(d1MinData));
print('Babi Degradada 1 -  MSI L2A - Data mais recente:', ee.Date(d1MaxData));
