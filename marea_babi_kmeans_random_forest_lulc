// ============================================================
// CLASSIFICAÇÃO COM RANDOM FOREST
// ============================================================

// ------------------------------------------------------------
// PARÂMETROS
// ------------------------------------------------------------

var numberOfTrainings = 10;
var sampleSizePerClass = 2500;
var trainFraction = 0.8;
var numberOfTrees = 200;

var generateFinalPlot = false;

// ============================================================
// CRIAR POOL DE PIXELS PARA CADA CLASSE
// ============================================================

// Número total de pixels necessários por classe.
// Cada pixel poderá pertencer a apenas um treinamento.
var totalSamplesPerClass =
  numberOfTrainings * sampleSizePerClass;


// ------------------------------------------------------------
// Manguezal = classe 1
// ------------------------------------------------------------

var mangrovePool = mosaic
  .select(bands)
  .sample({
    region: mangrovePolygons.geometry(),
    scale: 10,
    geometries: true
  })
  .filter(ee.Filter.notNull(bands))
  .randomColumn(
    'random',
    randomSeed
  )
  .sort('random')
  .limit(totalSamplesPerClass)
  .map(function(feature) {
    return feature.set('class', 1);
  });


// ------------------------------------------------------------
// Não-manguezal = classe 0
// ------------------------------------------------------------

var nonMangrovePool = mosaic
  .select(bands)
  .sample({
    region: nonMangrovePolygons.geometry(),
    scale: 10,
    geometries: true
  })
  .filter(ee.Filter.notNull(bands))
  .randomColumn(
    'random',
    randomSeed + 1
  )
  .sort('random')
  .limit(totalSamplesPerClass)
  .map(function(feature) {
    return feature.set('class', 0);
  });


// ============================================================
// VERIFICAR SE HÁ PIXELS SUFICIENTES
// ============================================================

print(
  'Pixels necessários por classe:',
  totalSamplesPerClass
);

print(
  'Pixels disponíveis - manguezal:',
  mangrovePool.size()
);

print(
  'Pixels disponíveis - não-manguezal:',
  nonMangrovePool.size()
);

// ============================================================
// HISTÓRICO DOS TREINAMENTOS
// ============================================================

var trainingHistory = [];


// ============================================================
// TREINAMENTOS
// ============================================================

for (var i = 0; i < numberOfTrainings; i++) {

  var trainingNumber = i + 1;

  // ----------------------------------------------------------
  // Selecionar bloco exclusivo de pixels
  // ----------------------------------------------------------
  
  var start = i * sampleSizePerClass;
  
  var mangroveSamples = ee.FeatureCollection(
    mangrovePool.toList(
      sampleSizePerClass,
      start
    )
  );
  
  var nonMangroveSamples = ee.FeatureCollection(
    nonMangrovePool.toList(
      sampleSizePerClass,
      start
    )
  );


  // ----------------------------------------------------------
  // Mesclar as duas classes
  // ----------------------------------------------------------

  var samples = mangroveSamples.merge(
    nonMangroveSamples
  );


  // ----------------------------------------------------------
  // Divisão treino / teste
  // ----------------------------------------------------------

  samples = samples.randomColumn(
    'split',
    randomSeed + trainingNumber
  );

  var trainSet = samples.filter(
    ee.Filter.lt(
      'split',
      trainFraction
    )
  );

  var testSet = samples.filter(
    ee.Filter.gte(
      'split',
      trainFraction
    )
  );


  // ----------------------------------------------------------
  // TREINAR RANDOM FOREST
  // ----------------------------------------------------------

  var classifier = ee.Classifier.smileRandomForest({
    numberOfTrees: numberOfTrees
  });

  classifier = classifier.train({
    features: trainSet,
    classProperty: 'class',
    inputProperties: bands
  });


  // ==========================================================
  // AVALIAÇÃO
  // ==========================================================

  // ----------------------------------------------------------
  // Treinamento
  // ----------------------------------------------------------

  var trainMatrix = classifier.confusionMatrix();

  var trainAccuracy = trainMatrix.accuracy();


  // ----------------------------------------------------------
  // Teste
  // ----------------------------------------------------------

  var testResults = testSet.classify(
    classifier
  );

  var testMatrix = testResults.errorMatrix(
    'class',
    'classification'
  );

  var testAccuracy = testMatrix.accuracy();
  var testKappa = testMatrix.kappa();


  // ----------------------------------------------------------
  // Matriz de confusão
  // ----------------------------------------------------------

  var matrixArray = testMatrix.array();

  var tn = matrixArray.get([0, 0]);
  var fp = matrixArray.get([0, 1]);
  var fn = matrixArray.get([1, 0]);
  var tp = matrixArray.get([1, 1]);


  // ==========================================================
  // CLASSIFICAR TODO O MOSAICO
  // ==========================================================

  var classification = mosaic
    .select(bands)
    .classify(classifier);


  // ==========================================================
  // ÁREA POR CLASSE
  // ==========================================================

  var areaHa = ee.Image.pixelArea()
    .divide(1e4);

  var areaStack = areaHa.addBands(
    classification
  );

  var areaDict = areaStack.reduceRegion({
    reducer: ee.Reducer.sum().group({
      groupField: 1,
      groupName: 'classification'
    }),
    geometry: roi,
    scale: 10,
    maxPixels: 1e13
  });


  var groups = ee.List(
    areaDict.get('groups')
  );


  // Área inicializada como zero.
  // Isso permite tratar o caso em que uma classe
  // eventualmente não apareça na classificação.

  var mangroveArea = ee.Number(0);
  var nonMangroveArea = ee.Number(0);


  // Obter as áreas usando filtros sobre os grupos.
  var mangroveGroup = groups.filter(
    ee.Filter.eq(
      'classification',
      1
    )
  );

  var nonMangroveGroup = groups.filter(
    ee.Filter.eq(
      'classification',
      0
    )
  );


  mangroveArea = ee.Number(
    ee.Algorithms.If(
      mangroveGroup.size().gt(0),
      ee.Dictionary(
        mangroveGroup.get(0)
      ).get('sum'),
      0
    )
  );

  nonMangroveArea = ee.Number(
    ee.Algorithms.If(
      nonMangroveGroup.size().gt(0),
      ee.Dictionary(
        nonMangroveGroup.get(0)
      ).get('sum'),
      0
    )
  );


  // ==========================================================
  // HISTÓRICO
  // ==========================================================

  var historyFeature = ee.Feature(
    null,
    {
      training: trainingNumber,

      sample_mangrove: mangroveSamples.size(),
      sample_non_mangrove: nonMangroveSamples.size(),

      train_size: trainSet.size(),
      test_size: testSet.size(),

      train_accuracy: trainAccuracy,

      test_accuracy: testAccuracy,
      test_kappa: testKappa,

      tn: tn,
      fp: fp,
      fn: fn,
      tp: tp,

      mangrove_area_ha: mangroveArea,
      non_mangrove_area_ha: nonMangroveArea
    }
  );

  trainingHistory.push(
    historyFeature
  );


  // ==========================================================
  // EXPORTAR CLASSIFIER
  // ==========================================================

  Export.classifier.toAsset({
    classifier: classifier,
    description: 'RF_training_' + trainingNumber,
    assetId: 'RF_training_' + trainingNumber
  });


  // ==========================================================
  // PLOT FINAL
  // ==========================================================

  if (generateFinalPlot) {

    Map.addLayer(
      classification,
      {
        min: 0,
        max: 1,
        palette: [
          '#2cc968',
          '#076132'
        ]
      },
      'RF training ' + trainingNumber,
      false
    );

  }

}


// ============================================================
// HISTÓRICO DOS TREINAMENTOS
// ============================================================

var trainingHistoryFc = ee.FeatureCollection(
  trainingHistory
);

print(
  'Training history:',
  trainingHistoryFc
);


// ============================================================
// EXPORTAR HISTÓRICO
// ============================================================

Export.table.toAsset({
  collection: trainingHistoryFc,
  description: 'RF_training_history',
  assetId: 'RF_training_history'
});


// ============================================================
// GRÁFICO FINAL
// ============================================================

if (generateFinalPlot) {

  var areaPlot = ui.Chart.feature.byFeature({
    features: trainingHistoryFc,
    xProperty: 'training',
    yProperties: [
      'mangrove_area_ha',
      'non_mangrove_area_ha'
    ]
  })
  .setChartType('LineChart')
  .setOptions({
    title: 'Predicted area by training',
    hAxis: {
      title: 'Training'
    },
    vAxis: {
      title: 'Area (ha)'
    },
    lineWidth: 2,
    pointSize: 4
  });

  print(areaPlot);

}