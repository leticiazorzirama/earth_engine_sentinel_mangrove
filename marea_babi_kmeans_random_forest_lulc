/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var bloco1 = ee.Image("projects/leticiazr/assets/babiDegr1_bloco1_seco_2016-04-20_a_2016-04-20"),
    babiDegr1 = ee.FeatureCollection("projects/leticiazr/assets/babiDegradada1"),
    bloco2 = ee.Image("projects/leticiazr/assets/babiDegr1_bloco2_chuvoso_2016-12-06_a_2016-12-06");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
// =============================
// IMPORTAR E VISUALIZAR ASSETS
// =============================

// Load uploaded table asset
var table = ee.FeatureCollection(babiDegr1);
var roi = table.union();
var mosaic = ee.Image(bloco2);

// Visualizacao em cor natural
var visParams = {
  bands: ['B4', 'B3', 'B2'],
  min: 0,
  max: 0.3,
  gamma: 1.4  
};

Map.addLayer(mosaic, visParams, 'Cor natural');
Map.centerObject(mosaic);

// ==============================
// DEFINIR VARIAVEIS DE ENTRADA
// ==============================

// O K-means utilizará os valores espectrais e dos índices
// para agrupar os pixels de acordo com sua similaridade.

var inputProperties = [
  'B1',
  'B2',
  'B3',
  'B4',
  'B5',
  'B6',
  'B7',
  'B8',
  'B8A',
  'B9',
  'B11',
  'B12',
  'ndvi',
  'ndwi',
  'evi',
  'mndwi',
  'mmri'
  ]

// ============================================================
// PREPARAR AMOSTRAS DE PIXELS PARA O AGRUPAMENTO
// ============================================================

// O K-means precisa de uma coleção de pixels/amostras a partir da qual
// estimará os centros dos clusters (centroides).
//
// Em vez de definir classes manualmente, amostramos pixels
// aleatoriamente por toda a ROI (Região de Interesse).

var numberOfSamples = 5000;

var trainingSamples = mosaic.select(inputProperties).sample({
    region: roi,
    scale: 10,
    numPixels: numberOfSamples,
    geometries: false
});

// Remover amostras que contenham valores nulos
trainingSamples = trainingSamples.filter(
    ee.Filter.notNull(inputProperties)
);

// // Filtrar pelo 80th percentil
// var p80Reducer = ee.Reducer.percentile([80]);

// var trainingSamples = mosaic.reduceRegions({
//   collection: trainingSamples,
//   reducer: p80Reducer,
//   scale: 10,
// });

print('Amostras de treinamento do K-means:', trainingSamples);
print('Número de amostras:', trainingSamples.size());


// ============================================================
// INSTANCIAR O K-MEANS
// ============================================================

var numberOfClusters = 5;

// Create K-means clusterer
var clusterer = ee.Clusterer.wekaKMeans({
    nClusters: numberOfClusters,
    seed: 42
});


// ============================================================
// TREINAR O K-MEANS
// ============================================================

// Treinar o modelo de agrupamento não supervisionado utilizando
// os pixels amostrados.
clusterer = clusterer.train(trainingSamples);

print('Agrupador K-means:', clusterer);


// ============================================================
// TESTE INDEPENDENTE EM TODO O MOSAICO
// ============================================================

var classification = mosaic
    .select(inputProperties)
    .cluster(clusterer);

// ============================================================
// VISUALIZAR OS AGRUPAMENTOS
// ============================================================

// Os IDs dos clusters são arbitrários.
//
// NÃO assuma que:
// cluster 0 = urbano
// cluster 1 = solo exposto
// cluster 2 = água
// cluster 3 = manguezal
// cluster 4 = floresta
//
// As cores abaixo são apenas para fins de visualização.

var clusterPalette = [
    '#d4271e',
    '#d1af86',
    '#1488ff',
    '#076132',
    '#2cc968'
];

Map.addLayer(
    classification,
    {
        min: 0,
        max: numberOfClusters - 1,
        palette: clusterPalette,
        format: 'png'
    },
    'Classificação K-means'
);

print('Classificação K-means:', classification);


// ============================================================
// CALCULAR A AREA DE CADA AGRUPAMENTO
// ============================================================

// Área do pixel em hectares
var areaHa = ee.Image.pixelArea().divide(1e4);


// Adicionar a banda de classificação
var areaStack = areaHa.addBands(classification);


// Calcular a área agrupada por cluster
var areaDict = areaStack.reduceRegion({
    reducer: ee.Reducer.sum().group({
        groupField: 1,
        groupName: 'cluster'
    }),
    geometry: roi,
    scale: 10,
    maxPixels: 1e13
});

print(
    'Tabela de áreas (ha) para cada cluster:',
    areaDict
);


// ===========================================================
// CONVERTER O DICIONARIO DE AREAS PARA COLECAO DE ATRIBUTOS
// ===========================================================

var groups = ee.List(areaDict.get('groups'));


var areaFc = ee.FeatureCollection(
    groups.map(function(item) {

        item = ee.Dictionary(item);

        var cluster = ee.Number(
            item.get('cluster')
        ).int();

        var area = item.get('sum');

        return ee.Feature(null, {
            cluster: cluster,
            cluster_label: ee.String('Cluster ')
                .cat(cluster.format()),
            area_ha: area
        });

    })
);


print(
    'FeatureCollection de áreas (ha) para cada cluster:',
    areaFc
);


// ============================================
// PLOTAR OS AGRUPAMENTOS EM GRAFICO DE BARRAS
// ============================================

var barPlot = ui.Chart.feature.groups({
    features: areaFc,
    xProperty: 'cluster_label',
    yProperty: 'area_ha',
    seriesProperty: 'cluster_label'
})
.setChartType('ColumnChart')
.setOptions({

    title: 'Área por cluster K-means',

    hAxis: {
        title: 'Agrupamento'
    },

    vAxis: {
        title: 'Área (ha)'
    },

    legend: {
        position: 'right'
    },

    isStacked: false,

    colors: clusterPalette,

    bar: {
        groupWidth: '100%'
    }

});

print(barPlot);

// 2.2. Collect manual samples
// Manually collect samples for the classification process. 
// Using the code editor's shape editing tool, draw polygons representing each class and import them as a FeatureCollection

// 2.2.1. Create a feature collection
// Classify five land cover classes: urban (0), bare soil (1), water (2), mangrove (3), forest (4). 

// 2.3. Generate random points
// Generate random points within these regions. 
// Proper distribution of the sampling polygons, combined with the random placement of points within them, ensures better representation of class variability. 
// Function to generate random points within the previously defined polygons.

// OBS.: There are other, more accurate ways to define the number of points to be collected. 
// For example, we can determine the size of the set of points using the proportion of the known area of your region of interest (ROI) as a reference.

// Create a function to collect random point inside the polygons
var generatePoints = function(polygons, nPoints){
    
    // Generate N random points inside the polygons
    var points = ee.FeatureCollection.randomPoints(polygons, nPoints);
    
    // Get the class value propertie
    var classValue = polygons.first().get('class');
    
    // Iterate over points and assign the class value
    points = points.map(
        function(point){
            return point.set('class', classValue);
        }
    );
    
    return points;
};

// Collect random points inside the polygons
var urbanPoints = generatePoints(urban, 1000);
var barePoints = generatePoints(bare, 1000);
var waterPoints = generatePoints(water, 1000);
var mangrovePoints = generatePoints(mangrove, 1000);
var forestPoints = generatePoints(forest, 1000);

// Merge all samples into a featureCollection
var samples = urbanPoints.merge(barePoints).merge(waterPoints).merge(mangrovePoints).merge(forestPoints);

print('Samples:', samples);

Map.addLayer(samples.filter(ee.Filter.eq('class', 0)), {color: '#d4271e'}, 'samples', false);
Map.addLayer(samples.filter(ee.Filter.eq('class', 1)), {color: '#d1af86'}, 'samples', false);
Map.addLayer(samples.filter(ee.Filter.eq('class', 2)), {color: '#1488ff'}, 'samples', false);
Map.addLayer(samples.filter(ee.Filter.eq('class', 3)), {color: '#076132'}, 'samples', false);
Map.addLayer(samples.filter(ee.Filter.eq('class', 4)), {color: '#2cc968'}, 'samples', false);

// 2.4. Collect the spectral information
// Extract the spectral information from their pixels.

// Collect the spectral information to get the trained samples
var trainedSamples = mosaic.reduceRegions({
    'collection': samples, 
    'reducer': ee.Reducer.first(), 
    'scale': 30,
  });

var trainedSamples = trainedSamples.filter(ee.Filter.notNull(['SR_B2_max']));

print('Train samples:', trainedSamples);

// 2.? Train and test splits
var trainedSamples = trainedSamples.randomColumn('random', 42); // seed for reprodutibility
var trainSet = trainedSamples.filter(ee.Filter.lessThan('random', 0.8));
var testSet = trainedSamples.filter(ee.Filter.greaterThanOrEquals('random', 0.8));

print('Train set:', trainSet);
print('Test set:', testSet);

// 2.5. Training the Random Forest classifier
// Set up the Random Forest classifier
var classifier = ee.Classifier.smileRandomForest({
    'numberOfTrees': 200
});

// Training the classifier on train set
classifier = classifier.train({
    'features': trainSet, 
    'classProperty': 'class', 
    'inputProperties': [
        'SR_B2_max',
        'SR_B2_median',
        'SR_B2_min',
        'SR_B3_max',
        'SR_B3_median',
        'SR_B3_min',
        'SR_B4_max',
        'SR_B4_median',
        'SR_B4_min',
        'SR_B5_max',
        'SR_B5_median',
        'SR_B5_min',
        'SR_B6_max',
        'SR_B6_median',
        'SR_B6_min',
        'SR_B7_max',
        'SR_B7_median',
        'SR_B7_min',
        'evi_max', 
        'evi_median',
        'evi_min',
        'mmri_max',
        'mmri_median',
        'mmri_min',
        'mndwi_max',
        'mndwi_median',
        'mndwi_min',
        'ndsi_max',
        'ndsi_median',
        'ndsi_min',
        'ndvi_max',
        'ndvi_median',
        'ndvi_min',
        'ndwi_max',
        'ndwi_median',
        'ndwi_min'
    ]
});


// 2. Evaluate the classifier on train set

// Confusion matrix: 
// Rows correspond to actual values, columns to predicted values
var trainMatrix = classifier.confusionMatrix(); 
var trainAccuracy = trainMatrix.accuracy()
print('Training confusion matrix: ', trainMatrix);
print('Training accuracy: ', trainAccuracy);

// 2.? Evaluate the classifier on test set

var testResults = testSet.classify(classifier);
var testMatrix = testResults.errorMatrix('class', ' ');
var testAccuracy = testMatrix.accuracy();
var testKappa = testMatrix.kappa();

print('Test confusion matrix: ', testMatrix);
print('Test accuracy:', testAccuracy)
print('Test kappa:', testKappa)

// 2.6. Predict with the classifier on entire image mosaic

// Run the Random Forest classifier
var classification = mosaic.classify(classifier);

// Pallete
var palette = [
  '#d4271e', // urban
  '#d1af86', // bare
  '#1488ff', // water
  '#076132', // mangrove
  '#2cc968', // forest
];

// Add classification to map
Map.addLayer(classification, {
        'min': 0,
        'max': 4,
        'palette': palette,
        'format': 'png'
    },
    'classification'
);

print('Classification:', classification);

// 2.? Calculate area for each class

// m2 to ha
var areaHa = ee.Image.pixelArea().divide(1e4); 

// Add classification band
var areaStack = areaHa.addBands(classification); 

// Group area per class
var areaDict = areaStack.reduceRegion({
    reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: 'classification'
  }),
  geometry: roi,
  scale: 30,
  maxPixels: 1e13
});
print('Table of areas (ha) for each class:', areaDict);

// Get groups data
var groups = ee.List(areaDict.get('groups'));

// Classes attributes table
var classDict = ee.Dictionary({
  '0': 'Urban',
  '1': 'Bare',
  '2': 'Water',
  '3': 'Mangrove',
  '4': 'Forest'
})

// Convert to feature collection
var areaFc = ee.FeatureCollection(
  groups.map(function(item){
    item = ee.Dictionary(item);
    var code = ee.Number(item.get('classification')).int();
    var area = item.get('sum');
    return ee.Feature(null, {
      class_code: code,
      class_label: classDict.get(code.format(), 'Desconhecido'),
      area_ha: area
    });
  })
);

print('Feature collection of areas (ha) for each class:', areaFc);

// Plot
var barPlot = ui.Chart.feature.groups({
    features: areaFc,
    xProperty: 'class_label',
    yProperty: 'area_ha',
    seriesProperty: 'class_label'
})
.setChartType('ColumnChart')     
.setOptions({
  title: 'Area per class',
  hAxis: {title: 'Land cover'},
  vAxis: {title: 'Area (ha)'},
  legend: {position: 'right'},
  isStacked: true,              
  colors: palette,       
  bar: {                      
    groupWidth: '100%' 
  }
});

print(barPlot);