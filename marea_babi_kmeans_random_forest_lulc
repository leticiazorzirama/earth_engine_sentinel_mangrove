/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var bloco1 = ee.Image("projects/leticiazr/assets/babiDegr1_bloco1_seco_2016-04-20_a_2016-04-20"),
    babiDegr1 = ee.FeatureCollection("projects/leticiazr/assets/babiDegradada1");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
// ==============================
// IMPORTAR ASSETS
// ==============================

var roi = ee.Polygon(babiDegr1)
var mosaic = ee.Image(bloco1);

// ==============================
// DEFINIR VARIAVEIS DE ENTRADA
// ==============================

// O K-means utilizará os valores espectrais e dos índices
// para agrupar os pixels de acordo com sua similaridade.

var inputProperties = mosaic.bandNames();
print(inputProperties);


// ============================================================
// PREPARAR AMOSTRAS DE PIXELS PARA O AGRUPAMENTO
// ============================================================

// O K-means precisa de uma coleção de pixels/amostras a partir da qual
// estimará os centros dos clusters (centroides).
//
// Em vez de definir classes manualmente, amostramos pixels
// aleatoriamente por toda a ROI (Região de Interesse).

var numberOfSamples = 5000;

var trainingSamples = image.select(inputProperties).sample({
    region: roi,
    scale: 30,
    numPixels: numberOfSamples,
    seed: 42,
    geometries: false
});

// Remover amostras que contenham valores nulos
trainingSamples = trainingSamples.filter(
    ee.Filter.notNull(inputProperties)
);

print('Amostras de treinamento do K-means:', trainingSamples);
print('Número de amostras:', trainingSamples.size());


// ============================================================
// 6. Configurar o K-means
// ============================================================

var numberOfClusters = 5;

// Criar o agrupador K-means
var clusterer = ee.Clusterer.wekaKMeans({
    nClusters: numberOfClusters,
    seed: 42
});

// ============================================================
// 7. Treinar o agrupador K-means
// ============================================================

// Treinar o modelo de agrupamento não supervisionado utilizando
// os pixels amostrados.
//
// Observe que não há o argumento classProperty.

clusterer = clusterer.train(trainingSamples);

print('Agrupador K-means:', clusterer);


// ============================================================
// 8. Aplicar o K-means a todo o mosaico
// ============================================================

// Classificar cada pixel de acordo com o centro de cluster mais próximo.

var classification = mosaic
    .select(inputProperties)
    .cluster(clusterer);


// ============================================================
// 9. Visualizar os clusters
// ============================================================

// Os IDs dos clusters são arbitrários.
//
// NÃO assuma que:
// cluster 0 = urbano
// cluster 1 = solo exposto
// cluster 2 = água
// cluster 3 = manguezal
// cluster 4 = floresta
//
// As cores abaixo são apenas para fins de visualização.

var clusterPalette = [
    '#d4271e',
    '#d1af86',
    '#1488ff',
    '#076132',
    '#2cc968'
];

Map.addLayer(
    classification,
    {
        min: 0,
        max: numberOfClusters - 1,
        palette: clusterPalette,
        format: 'png'
    },
    'Classificação K-means'
);

print('Classificação K-means:', classification);


// ============================================================
// 10. Calcular a área para cada cluster
// ============================================================

// Área do pixel em hectares

var areaHa = ee.Image.pixelArea().divide(1e4);


// Adicionar a banda de classificação

var areaStack = areaHa.addBands(classification);


// Calcular a área agrupada por cluster

var areaDict = areaStack.reduceRegion({
    reducer: ee.Reducer.sum().group({
        groupField: 1,
        groupName: 'cluster'
    }),
    geometry: roi,
    scale: 30,
    maxPixels: 1e13
});

print(
    'Tabela de áreas (ha) para cada cluster:',
    areaDict
);


// ============================================================
// 11. Converter o dicionário de áreas para FeatureCollection
// ============================================================

var groups = ee.List(areaDict.get('groups'));


var areaFc = ee.FeatureCollection(
    groups.map(function(item) {

        item = ee.Dictionary(item);

        var cluster = ee.Number(
            item.get('cluster')
        ).int();

        var area = item.get('sum');

        return ee.Feature(null, {
            cluster: cluster,
            cluster_label: ee.String('Cluster ')
                .cat(cluster.format()),
            area_ha: area
        });

    })
);


print(
    'FeatureCollection de áreas (ha) para cada cluster:',
    areaFc
);


// ============================================================
// 12. Gerar gráfico de barras com as áreas dos clusters
// ============================================================

var barPlot = ui.Chart.feature.groups({
    features: areaFc,
    xProperty: 'cluster_label',
    yProperty: 'area_ha',
    seriesProperty: 'cluster_label'
})
.setChartType('ColumnChart')
.setOptions({

    title: 'Área por cluster K-means',

    hAxis: {
        title: 'Cluster'
    },

    vAxis: {
        title: 'Área (ha)'
    },

    legend: {
        position: 'right'
    },

    isStacked: false,

    colors: clusterPalette,

    bar: {
        groupWidth: '100%'
    }

});


print(barPlot);