// Definir funcoes NDVI, NDWI, EVI, NDSI, MNDWI e MMRI
/**
 * @name
 *      computeNDVI
 * @description
 *      Calculates the Normalized Difference Vegetation Index (NDVI).
 *      NDVI is an indicator of vegetation health and greenness.
 * @param 
 *      {ee.Image} image - The input image containing bands SR_B5 (NIR) and SR_B4 (Red).
 * @returns 
 *      {ee.Image} - The input image with an additional 'ndvi' band.
 */
var computeNDVI = function(img) {
    // NDVI formula: (NIR - Red) / (NIR + Red)
    var exp = '( b("B8") - b("B4") ) / ( b("B8") + b("B4") )';
    
    // Calculate NDVI and rename the band to 'ndvi'.
    var ndvi = image.expression(exp).rename("ndvi");
    
    // Add the NDVI band to the image and return.
    return image.addBands(ndvi);
};

/**
 * @name
 *      computeNDWI
 * @description
 *      Calculates the Normalized Difference Water Index (NDWI).
 *      NDWI is used to highlight water bodies.
 * @param 
 *      {ee.Image} image - The input image containing bands SR_B5 (NIR) and SR_B6 (SWIR1).
 * @returns 
 *       {ee.Image} - The input image with an additional 'ndwi' band.
 */
var computeNDWI = function(img) {
    // NDWI formula: (NIR - SWIR1) / (NIR + SWIR1)
    var exp = 'float(b("B8") - b("B11")) / (b("B8") + b("B11"))';

    // Calculate NDWI and rename the band to 'ndwi'.
    var ndwi = image.expression(exp).rename("ndwi");

    // Add the NDWI band to the image and return.
    return image.addBands(ndwi); 
};

/**
 * @name
 *      computeEVI
 * @description
 *      Calculates the Enhanced Vegetation Index (EVI).
 *      EVI is used to quantify vegetation by reducing atmospheric and soil-related noise.
 * @param 
 *      {ee.Image} image - The input image containing bands SR_B5 (NIR), SR_B4 (Red), and SR_B2 (Blue).
 * @returns 
 *      {ee.Image} - The input image with an additional 'evi' band.
 */
var computeEVI = function(img) {
    // EVI formula: 2.5 * ((NIR - Red) / (NIR + 6 * Red - 7.5 * Blue + 1))
    var exp = '2.5 * ((b("B8") - b("B4")) / (b("B8") + 6 * b("B4") - 7.5 * b("B2") + 1))';

    // Calculate EVI and rename the band to 'evi'.
    var evi = image.expression(exp).rename("evi");

    // Add the EVI band to the image and return.
    return image.addBands(evi);
};

/**
* @name
*      computeNDSI
* @description
*      Calculates the Normalized Difference Soil Index (NDSI).
*      NDSI is used to gauge soil moisture content.
* @param  
*      {ee.Image} image - The input image containing bands SR_B5 (NIR) and SR_B6 (SWIR1).
* @returns 
*      {ee.Image} - The input image with an additional 'ndsi' band.
*/
var computeNDSI = function(img) {
    // NDSI formula: (SWIR1 - NIR) / (SWIR1 + NIR)   
    var exp = '(b("B11") - b("B8")) / (b("B11") + b("B8"))';

    // Calculate NDSI and rename the band to 'ndsi'.
    var ndsi = image.expression(exp).rename("ndsi");

    // Add the NDSI band to the image and return.
    return image.addBands(ndsi);
};

/**
 * @name
 *      computeMNDWI
 * @description
 *      Calculates the Modified Normalized Difference Water Index (MNDWI).
 *      MNDWI is used to enhance open water features while suppressing or removing noise from soil, vegetation, and built-up urban areas.
 * @param 
 *      {ee.Image} image - The input image containing bands SR_B3 (Green) and SR_B6 (SWIR1).
 * @returns 
 *      {ee.Image} - The input image with an additional 'mndwi' band.
 */
var computeMNDWI = function(img) {
    // MNDWI formula: (Green - SWIR1) / (Green + SWIR1)
    var exp = '(b("B3") - b("B11")) / (b("B3") + b("B11"))';

    // Calculate MNDWI and rename the band to 'mndwi'.
    var mndwi = image.expression(exp).rename("mndwi");

    // Add the MNDWI band to the image and return.
    return image.addBands(mndwi);
};
    
/**
 * @name
 *      computeMMRI
 * @description
 *      Calculates the Modular Mangrove Recognition Index (MMRI).
 *      MMRI is used to better discriminate mangrove forests from the surrounding vegetation.
 * @param 
 *      {ee.Image} image - The input image containing bands MNDWI e NDVI.
 * @returns 
 *      {ee.Image} - The input image with an additional 'mmri' band.
 */
var computeMMRI = function(img) {
    // MMRI = (|MNDWI| - |NDVI|) / (|MNDWI| + |NDVI|)
    var exp = '(abs(b("mndwi")) - abs(b("ndvi"))) / ' +
              '(abs(b("mndwi")) + abs(b("ndvi")))';

    // Calculate MMRI and rename the band to 'mmri'.
    var mmri = image.expression(exp).rename("mmri");

    // Add the MMRI band to the image and return.
    return image.addBands(mmri);
};

// Apply the functions to each image
// Apply the compute functions to each image in the collection.
var collectionWithIndexes = ordenado.map(function(img){
    .map(computeNDVI)
    .map(computeNDWI)
    .map(computeEVI)
    .map(computeNDSI)
    .map(computeMNDWI)
    .map(computeMMRI)
});

// ---- DETECTAR BLOCOS DE ESTACAO CONSECUTIVOS ----
var listaInfo = ordenado.map(function(img) {
  return ee.Feature(null, {
    'indice': img.get('system:index'),
    'time_start': img.get('system:time_start'),
    'estacao': img.get('estacao')
  });
}).getInfo().features;

var blocos = [];
var blocoAtual = null;

listaInfo.forEach(function(f) {
  var props = f.properties;
  if (blocoAtual === null || blocoAtual.estacao !== props.estacao) {
    blocoAtual = {
      estacao: props.estacao,
      indices: [],
      dataInicio: null,
      dataFim: null
    };
    blocos.push(blocoAtual);
  }
  blocoAtual.indices.push(props.indice);
  var dataImg = ee.Date(props.time_start).format('YYYY-MM-dd').getInfo();
  if (blocoAtual.dataInicio === null) blocoAtual.dataInicio = dataImg;
  blocoAtual.dataFim = dataImg;
});

print(AREA_ATUAL + ' - Blocos detectados:', blocos);

// ---- COMPOR/EXPORTAR CADA BLOCO ----
blocos.forEach(function(bloco, i) {
  var numImg = bloco.indices.length;
  var subColecao = ordenado.filter(ee.Filter.inList('system:index', bloco.indices));

  var imagemFinal = (numImg === 1)
    ? subColecao.first()
    : subColecao.median();

  imagemFinal = imagemFinal.clip(poligono);

  var nomeBloco = AREA_ATUAL + '_bloco' + (i + 1) + '_' + bloco.estacao
    + '_' + bloco.dataInicio + '_a_' + bloco.dataFim;

  print(nomeBloco + ' - n imagens: ' + numImg);

  Export.image.toDrive({
    image: imagemFinal,
    description: nomeBloco,
    folder: 'GEE_Exports',
    fileNamePrefix: nomeBloco,
    region: poligono,
    scale: 10,
    maxPixels: 1e13
  });
});

